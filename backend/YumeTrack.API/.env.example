# Copiá este archivo como .env y completá los valores. El .env real NO se sube a git.

# Base de datos PostgreSQL
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=yumetrack;Username=postgres;Password=CAMBIAR

# Clave para firmar los tokens JWT (mínimo 32 caracteres)
JwtSettings__Key=CAMBIAR-por-una-clave-larga-y-aleatoria-de-32-o-mas-caracteres

# Traducción de sinopsis (opcional)
DeepL__ApiKey=

# Correo para recuperar contraseña (opcional; sin esto el enlace se escribe en la consola)
Email__Host=smtp.gmail.com
Email__Port=587
Email__EnableSsl=true
Email__User=tucuenta@gmail.com
Email__Password=clave-de-aplicacion-de-google
Email__From="YumeTrack <tucuenta@gmail.com>"

# Dirección pública del front (para armar el enlace del correo)
App__FrontendUrl=http://localhost:5173
